# Never put real values in this file. Export secrets at runtime or use an ignored .env.
RUN_PROVIDER=lambdatest
LT_USERNAME=
LT_ACCESS_KEY=
LT_APP_ID=
JUST_TEST_PHONE=
JUST_TEST_OTP=
APK_PATH=apk/just.apk
DEVICE_NAME="Samsung Galaxy S22 5G"
ANDROID_VERSION=14
LT_TUNNEL_ENABLED=false
LT_TUNNEL_NAME=
SEARCH_TOP_N=10
MATRIX_CONCURRENCY=1
# Local debugging only. May capture credentials or personal data in failure screenshots.
ALLOW_SENSITIVE_LOCAL_SCREENSHOTS=false
